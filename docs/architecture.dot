digraph RiskLens {
  graph [rankdir=LR, label="RiskLens — architecture and implementation status", labelloc=t];
  node [shape=box, style="filled,rounded", fontname="Arial"];
  ui [label="Browser controls + session state\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  q [label="Five-question questionnaire\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  r [label="Rule-based risk inference\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  p [label="Profile + conflict clarification\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  s [label="Scenario selector + mode controls\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  d [label="Fictional portfolios + fixed advice\n[simulated]", fillcolor="#fff1dd", color="#be8c3f"];
  c [label="Risk-category comparator\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  v [label="Advice view; comparison only in Inspectable\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  f [label="Accept / decline feedback + history\n[implemented]", fillcolor="#e8f6ef", color="#3c8976"];
  l [label="Optional LLM dialogue; not connected\n[planned]", fillcolor="#f4f1fa", color="#9a7cb6", style="filled,rounded,dashed"];
  ui -> q [label="answers"];
  q -> r [label="score"];
  r -> p [label="category / conflict"];
  p -> q [label="correct answers"];
  p -> s [label="continue if ready"];
  s -> d [label="select example"];
  d -> c [label="portfolio risk"];
  r -> c [label="profile"];
  c -> v [label="comparison data"];
  d -> v [label="same advice in both modes"];
  s -> v [label="switch mode / scenario"];
  v -> f [label="accept / decline"];
  f -> v [label="reconsider"];
  v -> q [label="edit profile"];
  ui -> ui [label="reset to welcome; clear session"];
}
