flowchart TD
    ui["Browser controls + session state [implemented]"]
    q["Five-question questionnaire [implemented]"]
    r["Rule-based risk inference [implemented]"]
    p["Profile + conflict clarification [implemented]"]
    s["Scenario selector + mode controls [implemented]"]
    d["Fictional portfolios + fixed advice [simulated]"]
    c["Risk-category comparator [implemented]"]
    v["Advice view; comparison only in Inspectable [implemented]"]
    f["Accept / decline feedback + history [implemented]"]
    l["Optional LLM dialogue; not connected [planned]"]
    ui -->|answers| q
    q -->|score| r
    r -->|category / conflict| p
    p -->|correct answers| q
    p -->|continue if ready| s
    s -->|select example| d
    d -->|portfolio risk| c
    r -->|profile| c
    c -->|comparison data| v
    d -->|same advice in both modes| v
    s -->|switch mode / scenario| v
    v -->|accept / decline| f
    f -->|reconsider| v
    v -->|edit profile| q
    ui -->|reset to welcome; clear session| ui
    classDef implemented fill:#e8f6ef,stroke:#3c8976,color:#173a34;
    class ui,q,r,p,s,c,v,f implemented;
    classDef simulated fill:#fff1dd,stroke:#be8c3f,color:#173a34;
    class d simulated;
    classDef planned fill:#f4f1fa,stroke:#9a7cb6,color:#173a34;
    class l planned;
